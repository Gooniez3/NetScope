<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,18,24,14">
        <StackPanel Spacing="16" MaxWidth="520">

            <StackPanel>
                <TextBlock Classes="page-title" Text="Settings"/>
                <TextBlock Classes="page-subtitle" Text="Monitoring defaults and application information."/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="MONITORING DEFAULTS"/>
                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Default target"
                               VerticalAlignment="Center" Foreground="#8B949E" FontSize="12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                             Text="{Binding DefaultTarget}" MaxWidth="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval (sec)"
                               VerticalAlignment="Center" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DefaultInterval}"
                                   Minimum="1" Maximum="300" Width="148"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Probes/cycle"
                               VerticalAlignment="Center" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DefaultProbes}"
                                   Minimum="1" Maximum="20" Width="148"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (ms)"
                               VerticalAlignment="Center" Foreground="#8B949E" FontSize="12" Margin="0,8,0,0"/>
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DefaultTimeout}"
                                   Minimum="100" Maximum="30000" Width="148"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </Grid>
                <Button Classes="btn-primary" Content="Save" Command="{Binding SaveDefaultsCommand}"
                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8B949E"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <Border Height="1" Background="#21262D"/>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="DATABASE"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Path" VerticalAlignment="Center" Foreground="#8B949E" FontSize="12"/>
                    <TextBox Classes="field" Text="{Binding DatabasePath}" FontSize="11" IsReadOnly="True"
                             Foreground="#6E7681" MinWidth="280"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#21262D"/>

            <StackPanel Spacing="4">
                <TextBlock Classes="section-label" Text="ABOUT"/>
                <TextBlock Text="NetScope — Network Diagnostics" Foreground="#C9D1D9" FontSize="13"/>
                <TextBlock Text="Version 0.7.1" Foreground="#6E7681" FontSize="12"/>
                <TextBlock Text=".NET 10 · Avalonia 12 · ScottPlot 5" Foreground="#6E7681" FontSize="11"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
