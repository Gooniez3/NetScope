<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="24,18,24,14" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
            <StackPanel>
                <TextBlock Classes="page-title" Text="Settings"/>
                <TextBlock Classes="page-subtitle" Text="Monitoring defaults and application information."/>
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*">
                <StackPanel>
                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-label" Text="MONITORING DEFAULTS"/>
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Default target"
                                           VerticalAlignment="Center" Classes="muted"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                                         Text="{Binding DefaultTarget}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval (sec)"
                                           VerticalAlignment="Center" Classes="muted" Margin="0,8,0,0"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding DefaultInterval}"
                                               Minimum="1" Maximum="300"
                                               HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Probes/cycle"
                                           VerticalAlignment="Center" Classes="muted" Margin="0,8,0,0"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DefaultProbes}"
                                               Minimum="1" Maximum="20"
                                               HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (ms)"
                                           VerticalAlignment="Center" Classes="muted" Margin="0,8,0,0"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DefaultTimeout}"
                                               Minimum="100" Maximum="30000"
                                               HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-label" Text="APPLICATION"/>
                            <CheckBox IsChecked="{Binding CloseToTray}"
                                      Content="Close to tray — hide the window instead of quitting"/>
                            <Button Classes="btn-primary" Content="Save" Command="{Binding SaveDefaultsCommand}"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="Saved to ~/.netscope/settings.json" FontSize="11" Classes="muted"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Classes="settings-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-label" Text="PATHS"/>
                            <TextBlock Text="Database" Classes="muted" FontSize="11"/>
                            <TextBox Classes="field" Text="{Binding DatabasePath}" FontSize="11" IsReadOnly="True"/>
                            <TextBlock Text="Settings" Classes="muted" FontSize="11" Margin="0,6,0,0"/>
                            <TextBox Classes="field" Text="{Binding SettingsPath}" FontSize="11" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="settings-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-label" Text="ABOUT"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Source="/Assets/netscope.png" Width="32" Height="32" Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NetScope — Network Diagnostics" Classes="primary-text" FontSize="13"/>
                                    <TextBlock Text="Version 1.0.0" Classes="muted"/>
                                    <TextBlock Text=".NET 10 · Avalonia 12 · ScottPlot 5" FontSize="11" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
