<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <DockPanel Margin="24,18,24,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Classes="page-title" Text="Diagnostics"/>
            <TextBlock Classes="page-subtitle" Text="Run ping, DNS, traceroute, TCP ports, and LAN discovery against live hosts."/>
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">

            <TabItem Header="Ping">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Target"/>
                                <TextBox Classes="field" Text="{Binding PingTarget}" Width="180"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Count"/>
                                <NumericUpDown Value="{Binding PingCount}" Minimum="1" Maximum="100"
                                               Width="148"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Classes="btn-primary" Content="Run Ping" Command="{Binding RunPingCommand}"
                                        IsEnabled="{Binding !IsPinging}"/>
                                <Button Classes="btn-secondary" Content="Cancel" Command="{Binding CancelOperationCommand}"
                                        IsVisible="{Binding IsPinging}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding PingStatus}" FontSize="12" Foreground="#6E7681"/>
                        <TextBlock Text="{Binding PingSummary}" FontSize="12" Foreground="#8B949E"
                                   IsVisible="{Binding PingSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border Classes="empty-state" Margin="0,8,0,0"
                                IsVisible="{Binding !PingResults.Count}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No ping results yet" Classes="primary-text" FontWeight="SemiBold"/>
                                <TextBlock Text="Run Ping to measure round-trip time, loss, and jitter to a host."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding PingResults}" IsReadOnly="True"
                                  CanUserSortColumns="False" Margin="0,8,0,0"
                                  IsVisible="{Binding PingResults.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="50"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                            <DataGridTemplateColumn Header="RTT" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PingResultRow">
                                        <TextBlock Text="{Binding Rtt}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="DNS">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Hostname"/>
                                <TextBox Classes="field" Text="{Binding DnsHostname}" Width="260"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Classes="btn-primary" Content="Resolve" Command="{Binding RunDnsCommand}"
                                        IsEnabled="{Binding !IsResolving}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding DnsStatus}" FontSize="12" Foreground="#6E7681"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border Classes="empty-state" Margin="0,8,0,0"
                                IsVisible="{Binding !DnsResults.Count}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No DNS records yet" Classes="primary-text" FontWeight="SemiBold"/>
                                <TextBlock Text="Resolve a hostname to the addresses your resolver returns."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding DnsResults}" IsReadOnly="True"
                                  CanUserSortColumns="False" Margin="0,8,0,0"
                                  IsVisible="{Binding DnsResults.Count}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="280"/>
                                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Traceroute">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Target"/>
                                <TextBox Classes="field" Text="{Binding TraceTarget}" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Classes="btn-primary" Content="Trace Route" Command="{Binding RunTraceCommand}"
                                        IsEnabled="{Binding !IsTracing}"/>
                                <Button Classes="btn-secondary" Content="Cancel" Command="{Binding CancelOperationCommand}"
                                        IsVisible="{Binding IsTracing}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding TraceStatus}" FontSize="12" Foreground="#6E7681"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border Classes="empty-state" Margin="0,8,0,0"
                                IsVisible="{Binding !TraceHops.Count}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No hops yet" Classes="primary-text" FontWeight="SemiBold"/>
                                <TextBlock Text="Trace the ICMP path to a host. Timeouts show as *."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding TraceHops}" IsReadOnly="True"
                                  CanUserSortColumns="False" CanUserResizeColumns="True"
                                  Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                                  IsVisible="{Binding TraceHops.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="56" MinWidth="56"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150"/>
                            <DataGridTemplateColumn Header="Hostname" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TraceHopRow">
                                        <TextBlock Text="{Binding Hostname}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RTT" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TraceHopRow">
                                        <TextBlock Text="{Binding Rtt}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Ports">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Host"/>
                                <TextBox Classes="field" Text="{Binding PortHost}" Width="180"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Port"/>
                                <NumericUpDown Value="{Binding PortNumber}" Minimum="1" Maximum="65535"
                                               Width="148"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Preset"/>
                                <ComboBox Width="140" ItemsSource="{Binding PortPresets}"
                                          SelectedItem="{Binding SelectedPortPreset}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Classes="btn-primary" Content="Test Port" Command="{Binding RunPortTestCommand}"
                                        IsEnabled="{Binding !IsTestingPort}"/>
                                <Button Classes="btn-secondary" Content="Cancel" Command="{Binding CancelOperationCommand}"
                                        IsVisible="{Binding IsTestingPort}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding PortStatus}" FontSize="12" Classes="muted"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border Classes="empty-state" Margin="0,8,0,0"
                                IsVisible="{Binding !PortResults.Count}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No port tests yet" Classes="primary-text" FontWeight="SemiBold"/>
                                <TextBlock Text="TCP connect to a host and port. Presets fill common services."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding PortResults}" IsReadOnly="True"
                                  CanUserSortColumns="False" Margin="0,8,0,0"
                                  IsVisible="{Binding PortResults.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="160"/>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTemplateColumn Header="Connect" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PortResultRow">
                                        <TextBlock Text="{Binding ConnectTime}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="LAN Scan">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">
                    <StackPanel Spacing="8">
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,4">
                                <TextBlock Classes="field-label" Text="Subnet"/>
                                <TextBox Classes="field" Text="{Binding ScanSubnet}" Width="180"
                                         PlaceholderText="auto-detect"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Classes="btn-primary" Content="Scan Network" Command="{Binding RunScanCommand}"
                                        IsEnabled="{Binding !IsScanning}"/>
                                <Button Classes="btn-secondary" Content="Cancel" Command="{Binding CancelOperationCommand}"
                                        IsVisible="{Binding IsScanning}"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding ScanStatus}" FontSize="12" Foreground="#6E7681"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Border Classes="empty-state" Margin="0,8,0,0"
                                IsVisible="{Binding !ScannedDevices.Count}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No devices yet" Classes="primary-text" FontWeight="SemiBold"/>
                                <TextBlock Text="Scan the local subnet. Auto-detect uses the active interface and clamps wide prefixes to /24."
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding ScannedDevices}" IsReadOnly="True"
                                  CanUserSortColumns="False" CanUserResizeColumns="True"
                                  Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                                  IsVisible="{Binding ScannedDevices.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130"/>
                            <DataGridTemplateColumn Header="Hostname" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <TextBlock Text="{Binding Hostname}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="168"/>
                            <DataGridTemplateColumn Header="Response" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <TextBlock Text="{Binding ResponseTime}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
