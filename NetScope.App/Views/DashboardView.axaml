<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid Margin="24,18,24,14" RowDefinitions="Auto,Auto,Auto,*,2*">

        <!-- Header + connection line -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Classes="page-title" Text="Dashboard"/>
            <TextBlock Classes="page-subtitle"
                       Text="Monitor connection health and network performance."/>
            <TextBlock Text="Loading network information…" FontSize="12" Foreground="#6E7681"
                       Margin="0,8,0,0" IsVisible="{Binding IsLoading}"/>
            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,10,0,0">
                <TextBlock Text="{Binding InterfaceName}" FontSize="12" Foreground="#C9D1D9"/>
                <TextBlock Text="/" FontSize="12" Foreground="#30363D" Margin="12,0"/>
                <TextBlock Text="{Binding LocalIp}" FontSize="12" Foreground="#C9D1D9"/>
                <TextBlock Text="/" FontSize="12" Foreground="#30363D" Margin="12,0"/>
                <TextBlock Text="Gateway" FontSize="12" Foreground="#6E7681" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Gateway}" FontSize="12" Foreground="#C9D1D9"/>
                <TextBlock Text="/" FontSize="12" Foreground="#30363D" Margin="12,0"/>
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                           Foreground="{Binding ConnectionStatusColor}"/>
            </StackPanel>
        </StackPanel>

        <!-- Health summary -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Classes="section-label" Text="HEALTH" Margin="0,0,0,4"/>
                <TextBlock Classes="health-value" Text="{Binding HealthStatus}"
                           Foreground="{Binding HealthColor}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="metric-caption" Text="Latency"/>
                <TextBlock Classes="metric-value" Text="{Binding LatencyDisplay}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="metric-caption" Text="Packet Loss"/>
                <TextBlock Classes="metric-value" Text="{Binding PacketLossDisplay}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="metric-caption" Text="Jitter"/>
                <TextBlock Classes="metric-value" Text="{Binding JitterDisplay}" Margin="0,2,0,0"/>
            </StackPanel>
        </UniformGrid>

        <!-- Monitoring control bar -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Classes="field-label" Text="Target"/>
                <TextBox Classes="field" Text="{Binding MonitorTarget}" Width="200"
                         IsEnabled="{Binding !IsMonitoring}"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Classes="btn-primary" Content="Start Monitoring"
                    Command="{Binding StartQuickMonitorCommand}"
                    IsVisible="{Binding !IsMonitoring}"
                    VerticalAlignment="Bottom" Margin="12,0,0,0"/>
            <Button DockPanel.Dock="Left" Classes="btn-danger" Content="Stop Monitoring"
                    Command="{Binding StopMonitorCommand}"
                    IsVisible="{Binding IsMonitoring}"
                    VerticalAlignment="Bottom" Margin="12,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="Running" FontSize="12" Foreground="#8B949E"
                       VerticalAlignment="Bottom" Margin="12,0,0,6"
                       IsVisible="{Binding IsMonitoring}"/>
        </DockPanel>

        <!-- Live latency chart -->
        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Classes="section-label" Text="LIVE LATENCY"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorTarget}"
                           FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right"/>
            </DockPanel>
            <sp:AvaPlot x:Name="LatencyChart" MinHeight="110"/>
        </DockPanel>

        <!-- Recent measurements -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="RECENT MEASUREMENTS" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Bottom" Text="Start monitoring to see measurements."
                       FontSize="12" Foreground="#30363D" Margin="0,8,0,0"
                       IsVisible="{Binding !RecentMeasurements.Count}"/>
            <DataGrid ItemsSource="{Binding RecentMeasurements}"
                      IsReadOnly="True" CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="92" MinWidth="92"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="120" MinWidth="100"/>
                    <DataGridTemplateColumn Header="Latency" Width="96" MinWidth="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Latency}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Loss" Width="72" MinWidth="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Loss}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Jitter" Width="88" MinWidth="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Jitter}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
