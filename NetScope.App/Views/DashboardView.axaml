<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer Padding="28,24,28,16">
        <StackPanel>

            <TextBlock Classes="page-title" Text="Dashboard" Margin="0,0,0,20"/>

            <!-- Network info -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="INTERFACE"/>
                        <TextBlock Text="{Binding InterfaceName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="LOCAL IP"/>
                        <TextBlock Text="{Binding LocalIp}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E2E8F0"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="GATEWAY"/>
                        <TextBlock Text="{Binding Gateway}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E2E8F0"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="STATUS"/>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Health metrics -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Classes="card" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="HEALTH"/>
                        <TextBlock Classes="metric-value" Text="{Binding HealthStatus}"
                                   Foreground="{Binding HealthColor}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="LATENCY"/>
                        <TextBlock Classes="metric-value" Text="{Binding LatencyDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="PACKET LOSS"/>
                        <TextBlock Classes="metric-value" Text="{Binding PacketLossDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="JITTER"/>
                        <TextBlock Classes="metric-value" Text="{Binding JitterDisplay}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick monitor -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Quick Monitor" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Target" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                        <TextBox Classes="field" Text="{Binding MonitorTarget}" Width="200"/>
                        <Button Classes="success" Content="Start"
                                Command="{Binding StartQuickMonitorCommand}"
                                IsVisible="{Binding !IsMonitoring}"/>
                        <Button Classes="danger" Content="Stop"
                                Command="{Binding StopMonitorCommand}"
                                IsVisible="{Binding IsMonitoring}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent measurements -->
            <Border Classes="card" Padding="0">
                <StackPanel>
                    <TextBlock Classes="section-title" Margin="20,16,20,0" Text="Recent Measurements"/>
                    <DataGrid ItemsSource="{Binding RecentMeasurements}"
                              IsReadOnly="True" CanUserResizeColumns="True"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              MaxHeight="340" Margin="8,8,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="90"/>
                            <DataGridTextColumn Header="TARGET" Binding="{Binding Target}" Width="130"/>
                            <DataGridTextColumn Header="LATENCY" Binding="{Binding Latency}" Width="100"/>
                            <DataGridTextColumn Header="LOSS" Binding="{Binding Loss}" Width="80"/>
                            <DataGridTextColumn Header="JITTER" Binding="{Binding Jitter}" Width="100"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Start a quick monitor to see live measurements here."
                               IsVisible="{Binding !RecentMeasurements.Count}"
                               Foreground="#475569" FontSize="12" Margin="20,4,20,16"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
