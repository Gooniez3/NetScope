<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid RowDefinitions="Auto,*" Margin="20,16,20,12">

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#484F58" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Classes="btn-secondary" Content="Refresh" Command="{Binding LoadSessionsCommand}"/>
                <Button Classes="btn-secondary" Content="Cleanup 30d+" Command="{Binding CleanupCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="300,16,*">

            <!-- Sessions -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="SESSIONS" FontSize="11" FontWeight="SemiBold"
                           Foreground="#484F58" Margin="0,0,0,6"/>
                <Button DockPanel.Dock="Bottom" Classes="btn-secondary" Content="View Session"
                        Command="{Binding SelectSessionCommand}" CommandParameter="{Binding SelectedSession}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                          IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="36"/>
                        <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="120"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="80"/>
                        <DataGridTextColumn Header="Cyc" Binding="{Binding Cycles}" Width="42"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Session details -->
            <StackPanel Grid.Column="2" Spacing="10">

                <!-- Aggregate stats -->
                <Border Background="#161B22" CornerRadius="6" Padding="16,10" BorderBrush="#30363D"
                        BorderThickness="1" IsVisible="{Binding HasAggregate}">
                    <UniformGrid Columns="5">
                        <StackPanel>
                            <TextBlock Text="Measurements" FontSize="11" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggMeasurements}" FontSize="16" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Uptime" FontSize="11" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggUptime}" FontSize="16" FontWeight="SemiBold" Foreground="#3FB950"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Avg Latency" FontSize="11" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggLatency}" FontSize="16" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Avg Jitter" FontSize="11" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggJitter}" FontSize="16" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Avg Loss" FontSize="11" Foreground="#8B949E" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AggLoss}" FontSize="16" FontWeight="SemiBold" Foreground="#D29922"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Measurements -->
                <TextBlock Text="SESSION MEASUREMENTS" FontSize="11" FontWeight="SemiBold" Foreground="#484F58"/>
                <DataGrid ItemsSource="{Binding SessionMeasurements}"
                          IsReadOnly="True" CanUserResizeColumns="True"
                          CanUserSortColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                        <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="80"/>
                        <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="60"/>
                        <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
