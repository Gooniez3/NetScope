<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid Margin="24,18,24,14" RowDefinitions="Auto,*" ClipToBounds="True">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Classes="page-title" Text="History"/>
                <TextBlock Classes="page-subtitle" Text="{Binding StatusText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Classes="btn-secondary" Content="Refresh" Command="{Binding LoadSessionsCommand}"
                        ZIndex="2"/>
                <Button Classes="btn-secondary" Content="Cleanup 30d+" Command="{Binding CleanupCommand}"
                        ZIndex="2"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="380,20,*" ClipToBounds="True">

            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" ClipToBounds="True">
                <TextBlock Classes="section-label" Text="SESSIONS" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Text="Loading…" FontSize="12" Foreground="#6E7681"
                           IsVisible="{Binding IsLoading}" Margin="0,0,0,4"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Sessions}"
                          SelectedItem="{Binding SelectedSession}"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="44"/>
                        <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="*"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90"/>
                        <DataGridTextColumn Header="Cycles" Binding="{Binding Cycles}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="2" Classes="btn-secondary" Content="View Session"
                        Command="{Binding SelectSessionCommand}"
                        CommandParameter="{Binding SelectedSession}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"/>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,*" ClipToBounds="True">
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,12"
                      IsVisible="{Binding HasAggregate}">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="metric-caption" Text="Measurements"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggMeasurements}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="metric-caption" Text="Uptime"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggUptime}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="metric-caption" Text="Avg Latency"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggLatency}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Classes="metric-caption" Text="Avg Jitter"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggJitter}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Classes="metric-caption" Text="Avg Loss"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggLoss}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="section-label" Text="SESSION MEASUREMENTS" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Select a session to view its measurements."
                               FontSize="12" Foreground="#30363D"
                               IsVisible="{Binding !SessionMeasurements.Count}"/>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SessionMeasurements}"
                              IsReadOnly="True" CanUserResizeColumns="True"
                              CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="88"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                            <DataGridTemplateColumn Header="Latency" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Latency}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Loss" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Loss}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Jitter" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Jitter}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
