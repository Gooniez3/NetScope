<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid Margin="24,18,24,14" RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Classes="page-title" Text="History"/>
                <TextBlock Classes="page-subtitle" Text="{Binding StatusText}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="btn-secondary" Content="Refresh"
                    Command="{Binding LoadSessionsCommand}" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Classes="empty-state" VerticalAlignment="Top"
                IsVisible="{Binding !HasSessions}">
            <StackPanel Spacing="4">
                <TextBlock Text="No saved sessions" Classes="primary-text" FontWeight="SemiBold"/>
                <TextBlock Text="On Monitor, leave Save to database checked, then start a session. History stores those runs locally in SQLite."
                           Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,20,*" IsVisible="{Binding HasSessions}">

            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="28,100,*,28" Margin="10,0,8,4">
                    <TextBlock Classes="section-label" Text="#" Margin="0"/>
                    <TextBlock Grid.Column="1" Classes="section-label" Text="TIME" Margin="0"/>
                    <TextBlock Grid.Column="2" Classes="section-label" Text="TARGET" Margin="0"/>
                    <TextBlock Grid.Column="3" Classes="section-label" Text="N" Margin="0"
                               HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                    <Button Classes="btn-secondary" Content="Remove old data"
                            Command="{Binding CleanupCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Classes="btn-danger" Content="Clear all"
                            Command="{Binding ClearAllCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding !ConfirmingClearAll}"/>
                    <Button Classes="btn-danger" Content="Confirm clear"
                            Command="{Binding ClearAllCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding ConfirmingClearAll}"/>
                </StackPanel>
                <ListBox Classes="session-list"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRow">
                            <Grid ColumnDefinitions="28,100,*,28" Margin="8,0">
                                <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#6E7681"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StartedShort}" FontSize="12"
                                           Foreground="#E6EDF3" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" FontSize="12"
                                           Foreground="#8B949E" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding CyclesLabel}" FontSize="12"
                                           Foreground="#8B949E" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Classes="page-title" FontSize="14" Text="{Binding DetailTitle}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Classes="btn-danger" Content="Delete session"
                            Command="{Binding DeleteSessionCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14"
                             IsVisible="{Binding HasAggregate}">
                    <StackPanel>
                        <TextBlock Classes="metric-caption" Text="Measurements"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggMeasurements}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="metric-caption" Text="Uptime"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggUptime}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="metric-caption" Text="Avg Latency"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggLatency}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="metric-caption" Text="Avg Jitter"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggJitter}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="metric-caption" Text="Avg Loss"/>
                        <TextBlock Classes="metric-value" FontSize="16" Text="{Binding AggLoss}" Margin="0,2,0,0"/>
                    </StackPanel>
                </UniformGrid>

                <DockPanel Grid.Row="2" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Classes="section-label" Text="MEASUREMENTS" Margin="0,0,0,6"/>
                    <Border DockPanel.Dock="Top" Classes="empty-state"
                            IsVisible="{Binding !HasMeasurements}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Select a session" Classes="primary-text" FontWeight="SemiBold"/>
                            <TextBlock Text="Pick a run on the left to inspect its samples."
                                       Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <DataGrid DockPanel.Dock="Top"
                              ItemsSource="{Binding SessionMeasurements}"
                              IsVisible="{Binding HasMeasurements}"
                              Height="{Binding SessionMeasurements.Count, Converter={StaticResource RowListHeight}}"
                              IsReadOnly="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                            <DataGridTemplateColumn Header="Latency" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Latency}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Loss" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Loss}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Jitter" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Jitter}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:MeasurementRow">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
