<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="650"
             x:Class="NetScope.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="12,8,12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="History" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Classes="primary" Content="↻  Refresh"
                            Command="{Binding LoadSessionsCommand}"/>
                    <Button Content="🗑  Cleanup (30d)"
                            Command="{Binding CleanupCommand}"
                            Padding="12,8" CornerRadius="6"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Classes="status-text" Text="{Binding StatusText}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="8,0">
            <!-- Sessions list -->
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Sessions"/>
                    <DataGrid ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              IsReadOnly="True" CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              MaxHeight="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="36"/>
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="120"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90"/>
                            <DataGridTextColumn Header="Cyc" Binding="{Binding Cycles}" Width="42"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="View Session" Margin="0,8,0,0"
                            Command="{Binding SelectSessionCommand}"
                            CommandParameter="{Binding SelectedSession}"
                            Padding="12,6" CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- Session detail -->
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <!-- Aggregate -->
                <Border Classes="card" Margin="4,4,4,4" IsVisible="{Binding HasAggregate}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Classes="metric-label" Text="MEASUREMENTS"/>
                            <TextBlock Classes="metric-value" Text="{Binding AggMeasurements}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Classes="metric-label" Text="UPTIME"/>
                            <TextBlock Classes="metric-value" Text="{Binding AggUptime}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Classes="metric-label" Text="AVG LATENCY"/>
                            <TextBlock Classes="metric-value" Text="{Binding AggLatency}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Classes="metric-label" Text="AVG JITTER"/>
                            <TextBlock Classes="metric-value" Text="{Binding AggJitter}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,4">
                            <TextBlock Classes="metric-label" Text="AVG LOSS"/>
                            <TextBlock Classes="metric-value" Text="{Binding AggLoss}" FontSize="18"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Measurements -->
                <Border Classes="card" Margin="4,0,4,4">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="Session Measurements"/>
                        <DataGrid ItemsSource="{Binding SessionMeasurements}"
                                  IsReadOnly="True" CanUserResizeColumns="True"
                                  CanUserSortColumns="False" HeadersVisibility="Column"
                                  MaxHeight="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="110"/>
                                <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="80"/>
                                <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="60"/>
                                <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
