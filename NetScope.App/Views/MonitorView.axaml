<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="700"
             x:Class="NetScope.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <Grid Margin="24,18,24,14" RowDefinitions="Auto,Auto,Auto,*,2*">

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Classes="page-title" Text="Monitor"/>
                <TextBlock Classes="page-subtitle" Text="Configure and run continuous network monitoring."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Classes="btn-primary" Content="Start Monitoring"
                        Command="{Binding StartCommand}" IsVisible="{Binding !IsMonitoring}"/>
                <Button Classes="btn-danger" Content="Stop Monitoring"
                        Command="{Binding StopCommand}" IsVisible="{Binding IsMonitoring}"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Classes="section-label" Text="CONFIGURATION" Margin="0,0,0,8"/>
            <WrapPanel>
                <StackPanel Margin="0,0,20,6">
                    <TextBlock Classes="field-label" Text="Target"/>
                    <TextBox Classes="field" Text="{Binding Target}" Width="180"
                             IsEnabled="{Binding !IsMonitoring}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,6">
                    <TextBlock Classes="field-label" Text="Interval (s)"/>
                    <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="1" Maximum="300"
                                   Width="148" IsEnabled="{Binding !IsMonitoring}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,6">
                    <TextBlock Classes="field-label" Text="Probes"/>
                    <NumericUpDown Value="{Binding ProbesPerCycle}" Minimum="1" Maximum="20"
                                   Width="148" IsEnabled="{Binding !IsMonitoring}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,6">
                    <TextBlock Classes="field-label" Text="Timeout (ms)"/>
                    <NumericUpDown Value="{Binding TimeoutMs}" Minimum="100" Maximum="30000"
                                   Width="148" IsEnabled="{Binding !IsMonitoring}"/>
                </StackPanel>
                <CheckBox Content=" Save to database" IsChecked="{Binding SaveToDatabase}"
                          IsEnabled="{Binding !IsMonitoring}" Foreground="#8B949E" FontSize="12"
                          VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="160,1,*" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="section-label" Text="HEALTH" Margin="0,0,0,4"/>
                <TextBlock Classes="health-value" Text="{Binding HealthStatus}"
                           Foreground="{Binding HealthColor}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#6E7681" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#21262D" Margin="8,4,20,4"/>
            <UniformGrid Grid.Column="2" Columns="4" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Classes="metric-caption" Text="Latency"/>
                    <TextBlock Classes="metric-value" Text="{Binding LatencyDisplay}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="metric-caption" Text="Packet Loss"/>
                    <TextBlock Classes="metric-value" Text="{Binding LossDisplay}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="metric-caption" Text="Jitter"/>
                    <TextBlock Classes="metric-value" Text="{Binding JitterDisplay}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="metric-caption" Text="Cycles"/>
                    <TextBlock Classes="metric-value" Text="{Binding CycleCount}" Margin="0,2,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Classes="section-label" Text="LIVE LATENCY"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Target}"
                           FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right"/>
            </DockPanel>
            <sp:AvaPlot x:Name="LatencyChart" MinHeight="110"/>
        </DockPanel>

        <DockPanel Grid.Row="4">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Classes="section-label" Text="MEASUREMENTS"/>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#6E7681">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} total">
                            <Binding Path="Measurements.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Start monitoring to collect measurements."
                       FontSize="12" Foreground="#30363D" Margin="0,8,0,0"
                       IsVisible="{Binding !Measurements.Count}"/>
            <DataGrid ItemsSource="{Binding Measurements}"
                      IsReadOnly="True" CanUserResizeColumns="True"
                      CanUserSortColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="88"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="120"/>
                    <DataGridTemplateColumn Header="Latency" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Latency}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Loss" Width="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Loss}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Jitter" Width="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Jitter}" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:MeasurementRow">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
