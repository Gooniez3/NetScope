<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetScope.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="650"
             x:Class="NetScope.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <ScrollViewer>
        <StackPanel Margin="8">
            <TextBlock Text="Monitor" FontSize="22" FontWeight="Bold" Foreground="White" Margin="4,0,0,12"/>

            <!-- Config -->
            <Border Classes="card" Margin="4,0,4,8">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section-title" Text="Configuration"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <TextBlock Text="Target:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                            <TextBox Text="{Binding Target}" Width="160" FontSize="13"
                                     IsEnabled="{Binding !IsMonitoring}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <TextBlock Text="Interval (s):" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                            <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="1" Maximum="300"
                                           Width="90" FontSize="13" IsEnabled="{Binding !IsMonitoring}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                            <TextBlock Text="Probes:" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="13"/>
                            <NumericUpDown Value="{Binding ProbesPerCycle}" Minimum="1" Maximum="20"
                                           Width="80" FontSize="13" IsEnabled="{Binding !IsMonitoring}"/>
                        </StackPanel>
                        <CheckBox Content="Save to DB" IsChecked="{Binding SaveToDatabase}"
                                  IsEnabled="{Binding !IsMonitoring}" Margin="0,0,16,4"
                                  Foreground="#AAAAAA" FontSize="13"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="▶  Start Monitoring"
                                Command="{Binding StartCommand}"
                                IsVisible="{Binding !IsMonitoring}"/>
                        <Button Classes="danger" Content="■  Stop"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsMonitoring}"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                                   Foreground="#888888" FontSize="12" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Live metrics -->
            <WrapPanel Margin="0,0,0,8">
                <Border Classes="metric">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="HEALTH"/>
                        <TextBlock Classes="metric-value" Text="{Binding HealthStatus}"
                                   Foreground="{Binding HealthColor}"/>
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="LATENCY"/>
                        <TextBlock Classes="metric-value" Text="{Binding LatencyDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="PACKET LOSS"/>
                        <TextBlock Classes="metric-value" Text="{Binding LossDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="JITTER"/>
                        <TextBlock Classes="metric-value" Text="{Binding JitterDisplay}"/>
                    </StackPanel>
                </Border>
                <Border Classes="metric">
                    <StackPanel>
                        <TextBlock Classes="metric-label" Text="CYCLES"/>
                        <TextBlock Classes="metric-value" Text="{Binding CycleCount}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Latency history (text-based chart) -->
            <Border Classes="card" Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Latency History"/>
                    <ItemsControl ItemsSource="{Binding LatencyHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LatencyPoint">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                    <TextBlock Text="{Binding Time}" Width="60" FontSize="10" Foreground="#666666"/>
                                    <Border Background="#3B82F6" Height="6" CornerRadius="3"
                                            Width="{Binding Latency}" MaxWidth="400" MinWidth="2"/>
                                    <TextBlock FontSize="10" Foreground="#AAAAAA">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:F1} ms">
                                                <Binding Path="Latency"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No data yet. Start monitoring to see latency history."
                               IsVisible="{Binding !LatencyHistory.Count}"
                               Foreground="#555555" FontSize="12" Margin="0,8"/>
                </StackPanel>
            </Border>

            <!-- Measurements table -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="section-title" Text="Measurements"/>
                    <DataGrid ItemsSource="{Binding Measurements}"
                              IsReadOnly="True" CanUserResizeColumns="True"
                              CanUserSortColumns="False" HeadersVisibility="Column"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="120"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="90"/>
                            <DataGridTextColumn Header="Loss" Binding="{Binding Loss}" Width="70"/>
                            <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
